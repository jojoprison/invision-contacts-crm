# ===========================================
# Senior CRM - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values:
#   cp .env.sample .env
# ===========================================

# Application
PROJECT_NAME=Senior CRM
DEBUG=1                          # Set to 0 in production

# Database (must match docker-compose.yml for local dev)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=senior_crm
POSTGRES_PORT=5433               # 5433 to avoid conflict with host PostgreSQL

# Security
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30   # Access token lifetime
